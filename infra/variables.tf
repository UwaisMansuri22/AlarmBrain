variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "environment" {
  description = "Environment name"
  type        = string
  default     = "dev"
}

variable "project_name" {
  description = "Project name"
  type        = string
  default     = "alarmbrain"
}

variable "claude_api_key" {
  description = "Claude API key"
  type        = string
  sensitive   = true
}
